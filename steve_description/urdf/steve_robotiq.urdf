    <mu2>1</mu2>
    <fdir1>0 0 0</fdir1>
    <!--<slip1>0</slip1>
      <slip2>0</slip2>-->
    <kp>1e+13</kp>
    <kd>1</kd>
    <!--<max_vel>0.01</max_vel>
      <min_depth>0</min_depth>-->
    <sensor name="head_lidar_cameracolor" type="camera">
      <camera name="head_lidar_camera">
        <horizontal_fov>1.2393583018411736</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>1</visualize>
    </sensor>
    <sensor name="head_lidar_cameraired" type="camera">
      <camera name="head_lidar_camera">
        <horizontal_fov>1.2217304763960306</horizontal_fov>
        <image>
          <width>1024</width>
          <height>768</height>
          <format>L_INT8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.05</stddev>
        </noise>
      </camera>
      <always_on>1</always_on>
      <update_rate>90</update_rate>
      <visualize>0</visualize>
    </sensor>
    <sensor name="head_lidar_cameradepth" type="depth">
      <camera name="head_lidar_camera">
        <horizontal_fov>1.2217304763960306</horizontal_fov>
        <image>
          <width>1024</width>
          <height>768</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.100</stddev>
        </noise>
      </camera>
      <always_on>1</always_on>
      <update_rate>90</update_rate>
      <visualize>0</visualize>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="librealsense_gazebo_plugin.so" name="realsense_l515">
      <prefix>head_lidar_camera</prefix>
      <depthUpdateRate>30.0</depthUpdateRate>
      <colorUpdateRate>30.0</colorUpdateRate>
      <infraredUpdateRate>30.0</infraredUpdateRate>
      <depthTopicName>/camera/depth/image_rect_raw</depthTopicName>
      <depthCameraInfoTopicName>/camera/depth/camera_info</depthCameraInfoTopicName>
      <colorTopicName>/camera/color/image_raw</colorTopicName>
      <colorCameraInfoTopicName>/camera/color/camera_info</colorCameraInfoTopicName>
      <infraredTopicName>/camera/infra/image_raw</infraredTopicName>
      <infraredCameraInfoTopicName>/camera/infra/camera_info</infraredCameraInfoTopicName>
      <colorOpticalframeName>head_lidar_camera_color_optical_frame</colorOpticalframeName>
      <depthOpticalframeName>head_lidar_camera_depth_optical_frame</depthOpticalframeName>
      <infraredOpticalframeName>head_lidar_camera_infra_optical_frame</infraredOpticalframeName>
      <rangeMinDepth>0.2</rangeMinDepth>
      <rangeMaxDepth>10.0</rangeMaxDepth>
      <pointCloud>False</pointCloud>
      <pointCloudTopicName>/camera/depth/color/points</pointCloudTopicName>
      <pointCloudCutoff>0.25</pointCloudCutoff>
      <pointCloudCutoffMax>9.0</pointCloudCutoffMax>
    </plugin>
  </gazebo>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <link name="ur5_wrist_cam_mount_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://steve_description/meshes/ur5_wrist_cam_mount/ur5_wrist_cam_mount.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://steve_description/meshes/ur5_wrist_cam_mount/ur5_wrist_cam_mount.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="ur5e_wrist_3_link_wrist_d405_mount_joint" type="fixed">
    <parent link="ur5e_wrist_3_link"/>
    <child link="ur5_wrist_cam_mount_link"/>
    <origin rpy="0.0 0.0 1.5707963267948966" xyz="0.0 0.0 -0.03"/>
  </joint>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="wrist_camera_joint" type="fixed">
    <origin rpy="3.141592653589793 -1.7707963267948965 0.0" xyz="0.08 0.0 0.05"/>
    <parent link="ur5_wrist_cam_mount_link"/>
    <child link="wrist_camera_bottom_screw_frame"/>
  </joint>
  <link name="wrist_camera_bottom_screw_frame"/>
  <joint name="wrist_camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.01085 0.009 0.021"/>
    <parent link="wrist_camera_bottom_screw_frame"/>
    <child link="wrist_camera_link"/>
  </joint>
  <link name="wrist_camera_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0038 -0.009 0"/>
      <geometry>
        <mesh filename="package://steve_description/meshes/realsense/d405/d405.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0078 -0.009 0"/>
      <geometry>
        <box size="0.023 0.042 0.042"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <!-- camera depth joints and links -->
  <joint name="wrist_camera_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_depth_frame"/>
  </joint>
  <link name="wrist_camera_depth_frame"/>
  <joint name="wrist_camera_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_depth_frame"/>
    <child link="wrist_camera_depth_optical_frame"/>
  </joint>
  <link name="wrist_camera_depth_optical_frame"/>
  <!-- camera left IR joints and links -->
  <joint name="wrist_camera_infra1_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_infra1_frame"/>
  </joint>
  <link name="wrist_camera_infra1_frame"/>
  <joint name="wrist_camera_infra1_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_infra1_frame"/>
    <child link="wrist_camera_infra1_optical_frame"/>
  </joint>
  <link name="wrist_camera_infra1_optical_frame"/>
  <!-- camera right IR joints and links -->
  <joint name="wrist_camera_infra2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.018 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_infra2_frame"/>
  </joint>
  <link name="wrist_camera_infra2_frame"/>
  <joint name="wrist_camera_infra2_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_infra2_frame"/>
    <child link="wrist_camera_infra2_optical_frame"/>
  </joint>
  <link name="wrist_camera_infra2_optical_frame"/>
  <!-- camera color joints and links -->
  <joint name="wrist_camera_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_color_frame"/>
  </joint>
  <link name="wrist_camera_color_frame"/>
  <joint name="wrist_camera_color_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_color_frame"/>
    <child link="wrist_camera_color_optical_frame"/>
  </joint>
  <link name="wrist_camera_color_optical_frame"/>
  <joint name="wrist_camera_usb_plug_joint" type="fixed">
    <origin rpy="3.141592653589793 0 0" xyz="-0.01238 0.012000000000000002 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_usb_plug_link"/>
  </joint>
